{
	"compilerOptions": {
		"module": "NodeNext",
		"target": "ESNext",
		"lib": ["ESNext"],
		"moduleResolution": "NodeNext",
		"rootDir": "lib",
		"strict": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"checkJs": true,
		"types": ["node"]
	},
	"include": ["lib/**/*.d.ts", "lib/**/*.js"],
	"exclude": ["node_modules"],
	"typedocOptions": {
		"entryPoints": ["./lib/index.d.ts"],
		"out": "docs",
		"name": "libdnf"
	}
}
